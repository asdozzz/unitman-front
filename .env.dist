# OpenAPI-спецификация для генерации d.ts (yarn gen:api).
# Если не задана, берётся ${VITE_API_HOST}/doc.json
OPENAPI_URL=http://localhost:8082/api/doc.json
VITE_API_HOST=http://localhost:8082/api
VITE_CENTRIFUGE_HOST=ws://localhost:8000/connection/websocket
VITE_DEFAULT_LOCALE=en
VITE_FALLBACK_LOCALE=ru
# Диагностический лог событий канала unit_progress#<jobId> в консоли браузера.
# Поставьте false, чтобы выключить.
VITE_DEBUG_PROGRESS=true
