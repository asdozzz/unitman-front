{
  "name": "unitman-front",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "yarn gen:ai-tools:check && vue-tsc --noEmit && vite build",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test:ai-chat": "node scripts/check-ai-chat-error-details.mjs",
    "test:ai-chat-session": "node scripts/check-ai-chat-session-id.mjs",
    "test:ai-chat-agent": "node scripts/check-ai-chat-agent-loop.mjs",
    "test:ai-chat:all": "yarn test:ai-chat && yarn test:ai-chat-session && yarn test:ai-chat-agent",
    "test:e2e": "playwright test --config=playwright.config.cjs",
    "test:e2e:ui": "playwright test --config=playwright.config.cjs --ui",
    "test:e2e:report": "playwright show-report e2e/report",
    "test:e2e:docker": "docker run --rm --network host --ipc=host -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.48.2-jammy ./node_modules/.bin/playwright test --config=playwright.config.cjs",
    "test:e2e:install": "playwright install chromium",
    "dev": "vite",
    "gen:ai-tools": "node scripts/gen-ai-tools.mjs",
    "gen:ai-tools:check": "node scripts/gen-ai-tools.mjs --check",
    "gen:api": "node scripts/gen-api-types.mjs",
    "gen:api:check": "node scripts/gen-api-types.mjs --check",
    "preview": "vite preview"
  },
  "dependencies": {
    "@primer/octicons": "^19.42.0",
    "@quasar/extras": "^1.16.12",
    "@quasar/vite-plugin": "^1.7.0",
    "@types/node": "^20.4.4",
    "axios": "1.15.0",
    "centrifuge": "^5.2.2",
    "dayjs": "^1.11.13",
    "fuse.js": "^7.5.0",
    "pinia": "^2.1.4",
    "quasar": "^2.17.0",
    "sass": "^1.75.0",
    "vue": "^3.5.10",
    "vue-i18n": "11.1.10",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@playwright/test": "1.48.2",
    "@vitejs/plugin-vue": "^4.1.0",
    "openapi-typescript": "7",
    "typescript": "5.6.3",
    "vite": "^6.3.4",
    "vue-cli-plugin-quasar": "~5.0.2",
    "vue-tsc": "2.1.2"
  },
  "type": "module"
}
